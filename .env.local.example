# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-12-15

# PostHog analytics (Project Settings → Project API Key)
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com   # use https://eu.i.posthog.com for EU cloud

# Demo form email delivery (Resend — https://resend.com)
RESEND_API_KEY=re_xxxxxxxx                          # required to deliver /demo submissions
# DEMO_TO_EMAIL=hello@praiseloop.com                # optional, this is the default
# DEMO_FROM_EMAIL=PraiseLoop <noreply@updates.praiseloop.com>  # optional; must be @ a verified Resend domain (updates.praiseloop.com is verified)
